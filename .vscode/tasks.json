{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start MCP Server",
      "type": "shell",
      "command": "npm start",
      "problemMatcher": []
    },
    {
      "label": "IBM i MCP OPENOBJ",
      "type": "shell",
      "command": "OPENOBJ ${input:lib}"
    },
    {
      "label": "IBM i MCP OPENLIB",
      "type": "shell",
      "command": "OPENLIB"
    },
    {
      "label": "IBM i MCP OPENMBR",
      "type": "shell",
      "command": "OPENMBR ${input:lib} ${input:file}"
    },
    {
      "label": "IBM i MCP CPYSRC",
      "type": "shell",
      "command": "CPYSRC ${input:fromlib} ${input:file} ${input:tolib}"
    },
    {
      "label": "IBM i MCP CPYMBR",
      "type": "shell",
      "command": "CPYMBR ${input:fromlib} ${input:fromfile} ${input:mbr} ${input:tolib}"
    },
    {
      "label": "IBM i MCP CODEMBR",
      "type": "shell",
      "command": "CODEMBR ${input:lib} ${input:file} ${input:mbr}"
    },
    {
      "label": "IBM i MCP SAVEMBR",
      "type": "shell",
      "command": "SAVEMBR ${input:lib} ${input:file} ${input:mbr}"
    },
    {
      "label": "IBM i MCP CRTRPG",
      "type": "shell",
      "command": "CRTRPG ${input:targetlib} ${input:lib} ${input:file} ${input:mbr}",
      "problemMatcher": []
    },

   {
  "label": "IBM i MCP CRTSQLRPG",
  "type": "shell",
  "command": "CRTSQLRPG ${input:targetlib} ${input:lib} ${input:file} ${input:mbr}",
  "problemMatcher": []
},{
  "label": "IBM i MCP CRTPF",
  "type": "shell",
  "command": "CRTPF ${input:targetlib} ${input:lib} ${input:file} ${input:mbr}",
  "problemMatcher": []
},


    {
      "label": "IBM i MCP DEPLOYOBJ",
      "type": "shell",
      "command": "DEPLOYOBJ ${input:object} ${input:type} ${input:fromLib} ${input:toLib}",
      "problemMatcher": []
    },
    {
  "label": "IBM i MCP DEPLOYMBR",
  "type": "shell",
  "command": "DEPLOYMBR ${input:deployFromLib} ${input:deploySrcFile} ${input:deployMember} ${input:deployToLib}",
  "problemMatcher": []
}
  ],

  "inputs": [
    {
      "id": "lib",
      "type": "promptString",
      "description": "Library"
    },
    {
      "id": "file",
      "type": "promptString",
      "description": "Source File"
    },
    {
      "id": "mbr",
      "type": "promptString",
      "description": "Member"
    },
    {
  "id": "fromlib",
  "type": "promptString",
  "description": "From Library"
},
{
  "id": "tolib",
  "type": "promptString",
  "description": "To Library"
},
{
  "id": "fromfile",
  "type": "promptString",
  "description": "From Source File"
},
{
  "id": "ext",
  "type": "promptString",
  "description": "Extension"
},
{
  "id": "targetlib",
  "type": "promptString",
  "description": "Target Library"
},

{
    "id": "object",
    "type": "promptString",
    "description": "Object"
},
{
    "id": "type",
    "type": "promptString",
    "default": "*PGM",
    "description": "Object Type"
},
{
    "id": "fromLib",
    "type": "promptString",
    "description": "From Library"
},
{
    "id": "toLib",
    "type": "promptString",
    "description": "To Library"
},

{
  "id": "deployFromLib",
  "type": "promptString",
  "description": "Source Library"
},
{
  "id": "deploySrcFile",
  "type": "promptString",
  "description": "Source File"
},
{
  "id": "deployMember",
  "type": "promptString",
  "description": "Member"
},
{
  "id": "deployToLib",
  "type": "promptString",
  "description": "Target Library"
}


  ]
}